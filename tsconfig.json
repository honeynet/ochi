{
  "extends": "./node_modules/@tsconfig/svelte/tsconfig.json",
  "include": [
    "frontend/**/*.d.ts",
    "frontend/**/*.ts",
    "frontend/**/*.svelte"
  ],
  "exclude": [
    "node_modules/*",
    "__sapper__/*",
    "public/*",
    ".routify/**/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "types": ["svelte"]
  }
}
