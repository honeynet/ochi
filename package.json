{
  "name": "ochi",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:rollup": "rollup -c -w",
    "dev:routify": "routify --watch",
    "build": "routify && rollup -c",
    "start": "sirv public --single --no-clear",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "jest",
    "test-watch": "jest --watchAll",
    "format": "prettier --write '**/*.{svelte,ts}'",
    "generate": "npx ts-node -P tsconfig.generate.json ./scripts/generate.ts && npm run format",
    "generate-check": "npm run generate && git diff --quiet",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.18.2",
    "@playwright/test": "^1.64.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.1",
    "@roxi/routify": "^3.6.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jest": "^27.5.1",
    "babel-jest": "^28.1.0",
    "jest": "^28.1.0",
    "jest-environment-jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3",
    "rollup": "^2.80.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-copy": "^2",
    "svelte-jester": "^2.3.2",
    "svelte-preprocess": "^6.0.5",
    "ts-jest": "^28.0.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/google.accounts": "^0.0.2",
    "base64-js": "^1.5.1",
    "chevrotain": "^13.2.0",
    "hexy": "^0.3.4",
    "optionator": "^0.9.3",
    "prettier-plugin-svelte": "^4.1.1",
    "sirv-cli": "^2.0.0"
  },
  "routify": {
    "routesDir": {
      "default": "frontend/pages"
    },
    "mainEntryPoint": "frontend/main.ts",
    "rootComponent": "frontend/App.svelte",
    "extensions": [
      ".svelte"
    ]
  },
  "overrides": {
    "picomatch": "2.3.2",
    "@tootallnate/once": "2.0.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "rollup-plugin-livereload": {
      "livereload": "^0.10.3"
    }
  }
}
